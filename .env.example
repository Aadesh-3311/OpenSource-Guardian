# Application Configuration
APP_NAME="OpenSource Guardian"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Bindings
HOST=0.0.0.0
PORT=8000

# Optional Internal Secret
# API_SECRET_KEY=your_optional_secret_here

# GitHub Integration
# GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com

# Switch Agent Bridge Integration
SWITCH_API_URL=http://localhost:8080
# SWITCH_AGENT_ID=agent-your-id-here
# SWITCH_API_KEY=your_switch_agent_api_key_here
SWITCH_ROOMS=default
# SWITCH_CONNECTION_ID=optional-fixed-uuid
